{
  "name": "@bonifaceebuka/logsjar-expressjs",
  "version": "0.1.0",
  "description": "Expressjs SDK for Logsjar application monitoring.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": ["expressjs","monitoring-tool","sentry"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.0"
  }
}
